<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser">

    <!-- MCP Endpoint (Streamable HTTP transport) -->
    <browser:page
        name="@mcp"
        for="*"
        class="interaktiv.mcpapi.mcp.endpoint.MCPEndpoint"
        permission="zope2.View"
    />

    <!-- OAuth 2.0 Discovery Endpoint (RFC 8414) -->
    <!-- Alternative path for direct access -->
    <browser:page
        name="@mcp-oauth-discovery"
        for="*"
        class="interaktiv.mcpapi.mcp.oauth.OAuthDiscoveryEndpoint"
        permission="zope2.View"
    />

    <!-- .well-known traverser for standard OAuth discovery URL -->
    <browser:page
        name=".well-known"
        for="*"
        class="interaktiv.mcpapi.mcp.wellknown.WellKnownTraverser"
        permission="zope2.View"
    />

    <!-- OAuth 2.0 Authorization Endpoint -->
    <browser:page
        name="authorize"
        for="*"
        class="interaktiv.mcpapi.mcp.oauth.OAuthAuthorizeEndpoint"
        permission="zope2.View"
    />

    <!-- OAuth 2.0 Token Endpoint -->
    <browser:page
        name="@mcp-oauth-token"
        for="*"
        class="interaktiv.mcpapi.mcp.oauth.OAuthTokenEndpoint"
        permission="zope2.View"
    />

    <!-- OAuth 2.0 Token Endpoint (alternative path) -->
    <browser:page
        name="oauth/token"
        for="*"
        class="interaktiv.mcpapi.mcp.oauth.OAuthTokenEndpoint"
        permission="zope2.View"
    />

    <!-- OAuth 2.0 Token Endpoint (another alternative) -->
    <browser:page
        name="token"
        for="*"
        class="interaktiv.mcpapi.mcp.oauth.OAuthTokenEndpoint"
        permission="zope2.View"
    />

    <!-- OAuth 2.0 Dynamic Client Registration Endpoint (RFC 7591) -->
    <browser:page
        name="register"
        for="*"
        class="interaktiv.mcpapi.mcp.oauth.OAuthRegisterEndpoint"
        permission="zope2.View"
    />

</configure>
